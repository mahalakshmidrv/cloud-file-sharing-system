# Copy to .env values into your environment (the app reads real environment variables).
SECRET_KEY=change-me-to-a-long-random-string
MAX_UPLOAD_MB=50
USER_QUOTA_MB=200

# Local storage (default)
STORAGE_BACKEND=local
# UPLOAD_FOLDER=instance/uploads

# Amazon S3 storage
# STORAGE_BACKEND=s3
# S3_BUCKET=my-bucket
# S3_REGION=ap-south-1
# S3_PREFIX=cloudshare/
